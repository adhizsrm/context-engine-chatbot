# ==============================================================================
# LLM PROVIDER
# ==============================================================================
# Select exactly one:
# openrouter
# mistral
# grok
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=<Your-OpenRouter-API-KEY>
OPENROUTER_MODEL=<Your-Model>

# Mistral Configuration
MISTRAL_API_KEY=<Your-Mistral-API-KEY>
MISTRAL_MODEL=ministral-14b-2512

# Grok Configuration
GROK_API_KEY=<Your-Grok-API-KEY>
GROK_MODEL=grok-2-latest

MODEL_CONTEXT_WINDOW=256000
MAX_OUTPUT_TOKENS=4096
PROMPT_TOKEN_BUDGET=14600
TOKEN_ESTIMATION_RATIO=4.0


#TOP K chunk size
RETRIEVAL_TOP_K=10

# Exponential Decay Configuration
MEMORY_DECAY_FACTOR=0.8
MEMORY_DECAY_THRESHOLD=0.65

# Conversation Summarization Configuration
MAX_SUMMARY_LENGTH=300

# Weaviate Configuration
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY= <empty-currently>

DEBUG_MODE=true
VERBOSE_PROMPT_LOGGING=true

